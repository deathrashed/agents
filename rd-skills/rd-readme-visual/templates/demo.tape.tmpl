# Terminal recording for the README, generated by scripts/make-tape.py. Recorded at 2x so it stays sharp on
# retina screens; scripts/record.sh crops it, pads it evenly and adds a window bar. The prompt is minimal on
# purpose: the folder name and a chevron, no clock, duration, git state or language marker.
Output {{OUTPUT}}

Require zsh

Set Shell "bash"
Set Theme {{THEME_JSON}}
Set FontSize {{FONT_SIZE}}
Set Width {{WIDTH}}
Set Height {{HEIGHT}}
Set Padding {{PADDING}}
Set TypingSpeed 45ms

# Prompt set-up is hidden: zsh without the rest of the owner's config, optional syntax highlighting,
# a coloured folder name and chevron, and any env vars the command needs (for example FORCE_COLOR=1).
Hide
Type "exec zsh -f"
Enter
{{HIGHLIGHT}}Type `PROMPT=$'%{\e[38;2;{{FOLDER_RGB}}m%}{{PROMPT_NAME}}%{\e[0m%}\n%{\e[1;38;2;{{CHEVRON_RGB}}m%}{{CHEVRON}}%{\e[0m%} '`
Enter
{{EXPORTS}}Type "clear"
Enter
Show

Sleep 600ms
Type {{COMMAND}}
Sleep 400ms
Enter
# Slow commands: the wait is not recorded, the output is real.
Hide
{{WAIT}}
Show
Sleep 4s
