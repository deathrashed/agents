#!/usr/bin/env bash
# agents-check: read-only health check for ~/.agents and every agent that reads it.
# Usage: agents-check [--json] [--config=PATH]   (exit 1 on any FAIL, 2 if it cannot run)
# Portable: Linux + macOS. Needs a python3 with tomllib (>= 3.11) or tomli.
set -u
here=$(cd "$(dirname "$0")" && pwd)
for py in python3 python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys
try:
    import tomllib
except ImportError:
    import tomli' 2>/dev/null; then
    exec "$py" "$here/agents_check.py" "$@"
  fi
done
echo "agents-check: no python3 with tomllib/tomli found (macOS: brew install python)" >&2
exit 2
